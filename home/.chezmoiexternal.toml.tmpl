# Git repos that chezmoi clones on a new machine and pulls on `chezmoi update`.
# Edit and commit inside them as normal repos. Pulls are fast-forward only, so
# chezmoi never rebases or merges local commits; push them before `chezmoi update`.

[".config/nvim"]
    type = "git-repo"
{{- if eq .profile "personal" }}
    url = "git@github.com:amitrahman1026/init.lua.git"
{{- else }}
    url = "https://github.com/amitrahman1026/init.lua.git"
{{- end }}
    refreshPeriod = "168h"
    pull.args = ["--ff-only"]

{{- if eq .profile "personal" }}

["agent-workspace"]
    type = "git-repo"
    url = "git@github.com:amitrahman1026/agent-workspace.git"
    refreshPeriod = "168h"
    pull.args = ["--ff-only"]
{{- end }}

[".oh-my-zsh"]
    type = "git-repo"
    url = "https://github.com/ohmyzsh/ohmyzsh.git"
    refreshPeriod = "168h"
    pull.args = ["--ff-only"]

[".oh-my-zsh/custom/themes/powerlevel10k"]
    type = "git-repo"
    url = "https://github.com/romkatv/powerlevel10k.git"
    refreshPeriod = "168h"
    pull.args = ["--ff-only"]

[".oh-my-zsh/custom/plugins/zsh-autosuggestions"]
    type = "git-repo"
    url = "https://github.com/zsh-users/zsh-autosuggestions.git"
    refreshPeriod = "168h"
    pull.args = ["--ff-only"]

[".tmux/plugins/tpm"]
    type = "git-repo"
    url = "https://github.com/tmux-plugins/tpm.git"
    refreshPeriod = "168h"
    pull.args = ["--ff-only"]

{{- /* clice C++ language server, a release tarball in ~/.local so work machines need no admin rights.
       To upgrade, change the version. ~/.local/bin/clice links to its binary. */}}
{{- $cliceVersion := "1.0.0" }}
{{- $cliceTriples := dict
      "linux/amd64" "x86_64-unknown-linux-gnu"
      "linux/arm64" "aarch64-unknown-linux-gnu"
      "darwin/amd64" "x86_64-apple-darwin"
      "darwin/arm64" "aarch64-apple-darwin" }}
{{- $cliceTriple := get $cliceTriples (printf "%s/%s" .chezmoi.os .chezmoi.arch) }}
{{- if $cliceTriple }}

[".local/share/clice"]
    type = "archive"
    url = "https://github.com/clice-io/clice/releases/download/v{{ $cliceVersion }}/clice-{{ $cliceVersion }}.{{ $cliceTriple }}.tar.gz"
    exact = true
    stripComponents = 1
{{- end }}
