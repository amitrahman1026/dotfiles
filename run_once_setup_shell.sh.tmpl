#!/bin/bash

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

log() {
    echo -e "${BLUE}[$(date +'%H:%M:%S')]${NC} $1"
}

success() {
    echo -e "${GREEN}✓${NC} $1"
}

error() {
    echo -e "${RED}✗${NC} $1"
}

warn() {
    echo -e "${YELLOW}⚠${NC} $1"
}

# Set ZSH as default shell
if [[ $SHELL != *"zsh"* ]]; then
    log "Setting ZSH as default shell..."
    if command -v zsh &> /dev/null; then
        chsh -s $(which zsh)
        success "ZSH set as default shell"
    else
        error "ZSH not found, cannot set as default shell"
        exit 1
    fi
else
    success "ZSH is already the default shell"
fi

# Install Oh My Zsh if not already installed
if [ ! -d "$HOME/.oh-my-zsh" ]; then
    log "Installing Oh My Zsh..."
    sh -c "$(curl -fsSL https://raw.github.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
    success "Oh My Zsh installed"
else
    success "Oh My Zsh already installed"
fi

# Install Powerlevel10k theme
P10K_DIR="$HOME/.oh-my-zsh/custom/themes/powerlevel10k"
if [ ! -d "$P10K_DIR" ]; then
    log "Installing Powerlevel10k theme..."
    git clone --depth=1 https://github.com/romkatv/powerlevel10k.git "$P10K_DIR"
    success "Powerlevel10k theme installed"
else
    success "Powerlevel10k theme already installed"
fi

# Install zsh-autosuggestions plugin
AUTOSUGGESTIONS_DIR="$HOME/.oh-my-zsh/custom/plugins/zsh-autosuggestions"
if [ ! -d "$AUTOSUGGESTIONS_DIR" ]; then
    log "Installing zsh-autosuggestions plugin..."
    git clone https://github.com/zsh-users/zsh-autosuggestions "$AUTOSUGGESTIONS_DIR"
    success "zsh-autosuggestions plugin installed"
else
    success "zsh-autosuggestions plugin already installed"
fi

{{- if eq .chezmoi.os "darwin" }}
# macOS specific shell setup
log "Setting up macOS shell environment..."

# Install NVM if not present
if [ ! -d "$HOME/.nvm" ]; then
    log "Installing NVM..."
    curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.0/install.sh | bash
    success "NVM installed"
else
    success "NVM already installed"
fi

{{- else if eq .chezmoi.os "linux" }}
# Linux specific shell setup
log "Setting up Linux shell environment..."

# Install Rust/Cargo if not present
if ! command -v cargo &> /dev/null; then
    log "Installing Rust/Cargo..."
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
    source "$HOME/.cargo/env"
    success "Rust/Cargo installed"
else
    success "Rust/Cargo already installed"
fi

# Install NVM if not present
if [ ! -d "$HOME/.nvm" ]; then
    log "Installing NVM..."
    curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.0/install.sh | bash
    success "NVM installed"
else
    success "NVM already installed"
fi

{{- end }}

success "Shell setup completed!"